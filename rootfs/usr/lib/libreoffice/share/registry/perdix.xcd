<?xml version="1.0" encoding="UTF-8"?>
<!-- PERDIX OS defaults for LibreOffice (users can still change them in Tools > Options).
     Files in this folder are read by every LibreOffice start, on top of LibreOffice's own. -->
<oor:data xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:oor="http://openoffice.org/2001/registry">
  <dependency file="main"/>
  <oor:component-data oor:name="Common" oor:package="org.openoffice.Office">
    <!-- Save .xlsx/.pptx/.docx in their own format without asking "Keep current format?". -->
    <node oor:name="Save">
      <node oor:name="Document">
        <prop oor:name="WarnAlienFormat" oor:op="fuse">
          <value>false</value>
        </prop>
      </node>
    </node>
    <!-- No "Tip of the Day" window on the first start. -->
    <node oor:name="Misc">
      <prop oor:name="ShowTipOfTheDay" oor:op="fuse">
        <value>false</value>
      </prop>
    </node>
  </oor:component-data>
</oor:data>
