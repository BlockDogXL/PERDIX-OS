#!/usr/bin/env bash
# Keeps the desktop shell running: restarts it whenever it exits or crashes.
set -uo pipefail

[[ -r /etc/kiosk/kiosk.conf ]] && source /etc/kiosk/kiosk.conf
: "${KIOSK_RESTART_DELAY:=2}"

log_dir="${XDG_STATE_HOME:-$HOME/.local/state}/kiosk"
mkdir -p "$log_dir"

# Session helpers from PERDIX Control Center: the Stream Mix follower (Sharing) keeps the virtual
# microphone in step with the sound devices; the recording hotkey (F9) starts and stops OBS.
PYTHONPATH=/opt/kiosk-shell python -m kiosk_shell.services.sharing --follow >>"$log_dir/sharing.log" 2>&1 &
helpers=$!
PYTHONPATH=/opt/kiosk-shell python -m kiosk_shell.services.recorder --hotkey >>"$log_dir/recording.log" 2>&1 &
helpers="$helpers $!"
trap 'kill $helpers 2>/dev/null' EXIT

while true; do
    PYTHONPATH=/opt/kiosk-shell python -m kiosk_shell >>"$log_dir/shell.log" 2>&1
    status=$?
    echo "$(date -Is) shell exited with status $status, restarting" >>"$log_dir/shell.log"
    sleep "$KIOSK_RESTART_DELAY"
done
