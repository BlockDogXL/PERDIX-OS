#!/usr/bin/env python3
"""perdix-tune: the only root-level actions PERDIX Control Center may perform.

Run through pkexec; the polkit rule lets the kiosk user call it without a password, so
every argument is validated here and commands are run without a shell.

  perdix-tune governor <performance|powersave|schedutil|ondemand|conservative>
  perdix-tune tcp <bbr|cubic|reno>
  perdix-tune qos on <interface> <download-limit-mbit> <udp-ports>   e.g. 27015-27050,7000-8000
  perdix-tune qos off <interface>
"""

import os
import re
import shutil
import subprocess
import sys

GOVERNORS = ("performance", "powersave", "schedutil", "ondemand", "conservative")
TCP_ALGORITHMS = {"bbr": "fq", "cubic": "fq_codel", "reno": "fq_codel"}  # algorithm -> default qdisc
IFACE = re.compile(r"^[A-Za-z0-9_.-]{1,15}$")
MAX_RANGES = 16


class UsageError(Exception):
    pass


def check_iface(name: str, sys_class_net: str = "/sys/class/net") -> str:
    if not IFACE.match(name) or not os.path.isdir(os.path.join(sys_class_net, name)):
        raise UsageError(f"unknown network interface: {name!r}")
    return name


def parse_limit(text: str) -> int:
    if not text.isdigit() or not 1 <= int(text) <= 10000:
        raise UsageError("download limit must be 1-10000 Mbit/s")
    return int(text)


def parse_ports(text: str) -> list[tuple[int, int]]:
    """'27015-27050,7000' -> [(27015, 27050), (7000, 7000)]"""
    ranges = []
    for part in text.split(","):
        bounds = part.strip().split("-")
        if not 1 <= len(bounds) <= 2 or not all(b.strip().isdigit() for b in bounds):
            raise UsageError(f"bad port range: {part!r}")
        lo, hi = int(bounds[0]), int(bounds[-1])
        if not 1 <= lo <= hi <= 65535:
            raise UsageError(f"bad port range: {part!r}")
        ranges.append((lo, hi))
    if not 1 <= len(ranges) <= MAX_RANGES:
        raise UsageError(f"give 1-{MAX_RANGES} port ranges")
    return ranges


def port_masks(lo: int, hi: int) -> list[tuple[int, int]]:
    """Cover lo..hi with (value, mask) pairs for tc u32 matches (like CIDR blocks for ports)."""
    blocks = []
    while lo <= hi:
        size = 1
        while lo % (size * 2) == 0 and lo + size * 2 - 1 <= hi and size < 65536:
            size *= 2
        blocks.append((lo, 0xFFFF & ~(size - 1)))
        lo += size
    return blocks


def governor_commands(governor: str) -> list[list[str]]:
    if governor not in GOVERNORS:
        raise UsageError(f"unknown governor: {governor!r}")
    return [["cpupower", "frequency-set", "-g", governor]]


def tcp_commands(algorithm: str) -> tuple[list[list[str]], list[list[str]]]:
    """(required, best-effort). The fq default qdisc helps BBR pace but isn't required for it
    (kernel 4.13+), and the setting doesn't exist inside network namespaces."""
    if algorithm not in TCP_ALGORITHMS:
        raise UsageError(f"unknown TCP congestion control: {algorithm!r}")
    return ([["sysctl", "-w", f"net.ipv4.tcp_congestion_control={algorithm}"]],
            [["sysctl", "-w", f"net.core.default_qdisc={TCP_ALGORITHMS[algorithm]}"]])


def qos_off_commands(iface: str) -> list[list[str]]:
    return [["tc", "qdisc", "del", "dev", iface, "root"],
            ["tc", "qdisc", "del", "dev", iface, "ingress"]]


def qos_on_commands(iface: str, limit_mbit: int, ports: list[tuple[int, int]]) -> list[list[str]]:
    """Game UDP first, background downloads throttled.

    Upload (egress): a 3-band priority queue. UDP packets to the game ports go to the top
    band; everything else uses the normal bands. Each band runs fq_codel to keep queues short.
    Download (ingress): only TCP (downloads, updates, streams) is policed to the limit, so it
    can't fill the line and raise game latency; game UDP is never touched.
    IPv4 only.
    """
    tc = ["tc"]
    commands = [
        [*tc, "qdisc", "add", "dev", iface, "root", "handle", "1:", "prio", "bands", "3"],
        [*tc, "qdisc", "add", "dev", iface, "parent", "1:1", "handle", "10:", "fq_codel"],
        [*tc, "qdisc", "add", "dev", iface, "parent", "1:2", "handle", "20:", "fq_codel"],
        [*tc, "qdisc", "add", "dev", iface, "parent", "1:3", "handle", "30:", "fq_codel"],
        [*tc, "qdisc", "add", "dev", iface, "handle", "ffff:", "ingress"],
    ]
    for lo, hi in ports:
        for value, mask in port_masks(lo, hi):
            commands.append([*tc, "filter", "add", "dev", iface, "parent", "1:", "protocol", "ip", "prio", "1",
                             "u32", "match", "ip", "protocol", "17", "0xff",
                             "match", "ip", "dport", str(value), f"0x{mask:04x}", "flowid", "1:1"])
    burst_kb = max(32, limit_mbit * 125 // 10)  # about 10 ms of traffic at the limit
    commands.append([*tc, "filter", "add", "dev", iface, "parent", "ffff:", "protocol", "ip", "prio", "10",
                     "u32", "match", "ip", "protocol", "6", "0xff",
                     "police", "rate", f"{limit_mbit}mbit", "burst", f"{burst_kb}k", "drop", "flowid", ":1"])
    return commands


def plan(args: list[str]) -> tuple[list[list[str]], list[list[str]]]:
    """(commands that must succeed, best-effort commands run first whose errors are ignored)"""
    match args:
        case ["governor", governor]:
            return governor_commands(governor), []
        case ["tcp", algorithm]:
            return tcp_commands(algorithm)
        case ["qos", "on", iface, limit, ports]:
            iface = check_iface(iface)
            return qos_on_commands(iface, parse_limit(limit), parse_ports(ports)), qos_off_commands(iface)
        case ["qos", "off", iface]:
            return [], qos_off_commands(check_iface(iface))
    raise UsageError(__doc__.split("\n\n", 2)[2])


def main(argv: list[str]) -> int:
    try:
        commands, cleanup = plan(argv)
    except UsageError as error:
        print(f"perdix-tune: {error}", file=sys.stderr)
        return 2
    for command in cleanup:
        subprocess.run(command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    for command in commands:
        if shutil.which(command[0]) is None:
            print(f"perdix-tune: {command[0]} is not installed", file=sys.stderr)
            return 1
        result = subprocess.run(command, capture_output=True, text=True)
        if result.returncode != 0:
            print(f"perdix-tune: {' '.join(command)}: {result.stderr.strip()}", file=sys.stderr)
            return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
