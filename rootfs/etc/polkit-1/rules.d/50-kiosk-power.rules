// The kiosk user may, without a password: power off, reboot and suspend, run
// /usr/local/bin/perdix-tune (CPU governor, TCP congestion control, QoS, hardening) through
// pkexec, and manage Wi-Fi through NetworkManager. Nothing else.
polkit.addRule(function (action, subject) {
    var allowed = [
        "org.freedesktop.login1.power-off",
        "org.freedesktop.login1.power-off-multiple-sessions",
        "org.freedesktop.login1.reboot",
        "org.freedesktop.login1.reboot-multiple-sessions",
        "org.freedesktop.login1.suspend",
        "org.perdix.tune",
        // Network Settings in the Control Center (nmcli): join, scan, disconnect and forget
        // Wi-Fi networks and turn the radio on or off. Saving a Wi-Fi password writes a
        // system profile, which NetworkManager otherwise reserves for administrators.
        "org.freedesktop.NetworkManager.network-control",
        "org.freedesktop.NetworkManager.settings.modify.system",
        "org.freedesktop.NetworkManager.settings.modify.own",
        "org.freedesktop.NetworkManager.enable-disable-wifi",
        "org.freedesktop.NetworkManager.wifi.scan",
    ];
    if (subject.user === "kiosk" && allowed.indexOf(action.id) >= 0) {
        return polkit.Result.YES;
    }
});
